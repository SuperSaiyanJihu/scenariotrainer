generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  SUPERVISOR
  ADMINISTRATOR
}

enum ScenarioStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScenarioCategory {
  PARENT_CONVERSATIONS
  INSTRUCTOR_COACHING
  SUPERVISOR_FEEDBACK
  COWORKER_COMMUNICATION
}

enum ScenarioDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ModeAvailability {
  TEXT_ONLY
  VOICE_ONLY
  TEXT_AND_VOICE
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum AttemptMode {
  TEXT
  VOICE
}

enum AttemptStatus {
  IN_PROGRESS
  EVALUATING
  COMPLETED
  FAILED
  ABANDONED
}

enum MessageSpeaker {
  EMPLOYEE
  CHARACTER
  SYSTEM
}

enum AuditAction {
  SCENARIO_CREATED
  SCENARIO_UPDATED
  SCENARIO_PUBLISHED
  SCENARIO_ARCHIVED
  SCENARIO_DUPLICATED
  ASSIGNMENT_CREATED
  SETTINGS_UPDATED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(EMPLOYEE)
  supervisorId   String?
  supervisor     User?    @relation("SupervisorReports", fields: [supervisorId], references: [id])
  directReports  User[]   @relation("SupervisorReports")
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdScenarios   PracticeScenario[] @relation("ScenarioCreatedBy")
  updatedScenarios   PracticeScenario[] @relation("ScenarioUpdatedBy")
  assignments        PracticeAssignment[] @relation("AssignmentTarget")
  assignedBy         PracticeAssignment[] @relation("AssignmentAssignedBy")
  attempts           PracticeAttempt[]
  auditLogs          AuditLog[]

  accounts Account[]
  sessions Session[]
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     User[]
  assignments PracticeAssignment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppSettings {
  id                        String   @id @default("default")
  practiceLabEnabled        Boolean  @default(true)
  practiceLabVoiceEnabled   Boolean  @default(true)
  supervisorCanViewTranscripts Boolean @default(false)
  transcriptRetentionDays   Int      @default(365)
  updatedAt                 DateTime @updatedAt
}

model PracticeScenario {
  id                         String             @id @default(cuid())
  title                      String
  slug                       String             @unique
  description                String
  category                   ScenarioCategory
  difficulty                 ScenarioDifficulty
  estimatedMinutes           Int
  employeeRole               String
  aiCharacterName            String
  aiCharacterRole            String
  aiCharacterDescription     String
  startingEmotionalState     String             @default("")
  conversationStyle          String             @default("")
  situationBackground        String
  openingMessage             String
  roleplayInstructions       String
  hiddenCharacterInformation String
  escalationInstructions     String
  deescalationConditions     String
  successConditions          String
  prohibitedAssistantBehaviors String
  policyContext              String             @default("")
  modeAvailability           ModeAvailability   @default(TEXT_AND_VOICE)
  passingScore               Int                @default(70)
  maximumDurationMinutes     Int                @default(15)
  status                     ScenarioStatus     @default(DRAFT)
  version                    Int                @default(1)
  createdById                String
  updatedById                String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  createdBy    User @relation("ScenarioCreatedBy", fields: [createdById], references: [id])
  updatedBy    User? @relation("ScenarioUpdatedBy", fields: [updatedById], references: [id])
  rubricCriteria PracticeRubricCriterion[]
  criticalErrors PracticeCriticalError[]
  assignments  PracticeAssignment[]
  attempts     PracticeAttempt[]
  versions     PracticeScenarioVersion[]
}

model PracticeScenarioVersion {
  id         String   @id @default(cuid())
  scenarioId String
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now())

  scenario PracticeScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, version])
}

model PracticeRubricCriterion {
  id                 String @id @default(cuid())
  scenarioId         String
  name               String
  description        String
  weight             Int
  scoringGuidance    String
  positiveIndicators String
  negativeIndicators String
  sortOrder          Int    @default(0)

  scenario PracticeScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scores   PracticeCriterionScore[]
}

model PracticeCriticalError {
  id               String  @id @default(cuid())
  scenarioId       String
  name             String
  description      String
  scoreEffect      Int     @default(0)
  automaticFailure Boolean @default(false)
  sortOrder        Int     @default(0)

  scenario PracticeScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model PracticeAssignment {
  id                 String           @id @default(cuid())
  scenarioId         String
  assignedToUserId   String?
  teamId             String?
  required           Boolean          @default(false)
  dueDate            DateTime?
  minimumPassingScore Int?
  maximumAttempts    Int?
  status             AssignmentStatus @default(ASSIGNED)
  assignedById       String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  scenario   PracticeScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("AssignmentTarget", fields: [assignedToUserId], references: [id])
  team       Team?            @relation(fields: [teamId], references: [id])
  assignedBy User             @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  attempts   PracticeAttempt[]
}

model PracticeAttempt {
  id                   String        @id @default(cuid())
  scenarioId           String
  scenarioVersion      Int
  scenarioSnapshot     Json
  userId               String
  assignmentId         String?
  mode                 AttemptMode
  status               AttemptStatus @default(IN_PROGRESS)
  isPreview            Boolean       @default(false)
  startedAt            DateTime      @default(now())
  endedAt              DateTime?
  durationSeconds      Int?
  overallScore         Int?
  passed               Boolean?
  evaluatorVersion     String        @default("1.0")
  roleplayModel        String?
  evaluationModel      String?
  modelMetadata        Json?
  reflectionCompletedAt DateTime?
  evaluationRetryCount Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  scenario   PracticeScenario   @relation(fields: [scenarioId], references: [id])
  user       User               @relation(fields: [userId], references: [id])
  assignment PracticeAssignment? @relation(fields: [assignmentId], references: [id])
  messages   PracticeMessage[]
  evaluation PracticeEvaluation?
  reflections PracticeReflection[]
}

model PracticeMessage {
  id              String         @id @default(cuid())
  attemptId       String
  speaker         MessageSpeaker
  content         String
  sequence        Int
  audioDurationMs Int?
  metadata        Json?
  createdAt       DateTime       @default(now())

  attempt PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sequence])
}

model PracticeEvaluation {
  id               String   @id @default(cuid())
  attemptId        String   @unique
  overallSummary   String
  strengths        Json
  opportunities    Json
  suggestedLanguage Json
  criticalErrors   Json
  evidence         Json
  nextPracticeFocus String
  createdAt        DateTime @default(now())

  attempt         PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  criterionScores PracticeCriterionScore[]
}

model PracticeCriterionScore {
  id                   String @id @default(cuid())
  evaluationId         String
  rubricCriterionId    String?
  criterionNameSnapshot String
  weightSnapshot       Int
  rawScore             Int
  weightedScore        Float
  feedback             String
  evidence             Json
  createdAt            DateTime @default(now())

  evaluation      PracticeEvaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rubricCriterion PracticeRubricCriterion? @relation(fields: [rubricCriterionId], references: [id])
}

model PracticeReflection {
  id               String   @id @default(cuid())
  attemptId        String
  question         String
  purpose          String   @default("")
  employeeResponse String?
  aiFollowUp       String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])
}
