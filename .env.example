# Database
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/performance_pulse?schema=public"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="development-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY=""
OPENAI_ROLEPLAY_MODEL="gpt-4o-mini"
OPENAI_EVALUATION_MODEL="gpt-4o-mini"
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"

# Practice Lab
PRACTICE_LAB_ENABLED=true
PRACTICE_LAB_VOICE_ENABLED=true
PRACTICE_LAB_MAX_TEXT_TURNS=40
PRACTICE_LAB_MAX_SESSION_MINUTES=15
PRACTICE_LAB_EVALUATION_RETRY_LIMIT=3
